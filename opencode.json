{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gateway",
      "options": {
        "baseURL": "{env:LLM_GATEWAY_BASE_URL}",
        "apiKey": "{env:LLM_GATEWAY_API_KEY_WORKER}"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git push --force*": "deny",
      "gh pr merge*": "deny",
      "gh release*": "deny",
      "gh secret*": "deny",
      "gh auth*": "deny"
    },
    "external_directory": {
      "*": "deny",
      "/tmp/opencode/*": "allow",
      "/tmp/opencode/**": "allow"
    }
  },
  "instructions": ["AGENTS.md"]
}
