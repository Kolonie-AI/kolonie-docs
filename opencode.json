{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gateway",
      "options": {
        "baseURL": "{env:OPENCODE_LLM_BASE_URL}",
        "apiKey": "{env:OPENCODE_LLM_API_KEY}"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git push --force*": "deny",
      "gh pr merge*": "deny",
      "gh release*": "deny",
      "gh secret*": "deny",
      "gh auth*": "deny"
    }
  },
  "instructions": ["AGENTS.md"]
}
